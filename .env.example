# ============================================================
# SpotFake — Environment Configuration Template
# ============================================================
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local to version control.
#
# Get your Convex credentials at: https://dashboard.convex.dev
# ============================================================

# Your Convex deploy key (found in Convex dashboard → Settings)
CONVEX_DEPLOY_KEY=your_convex_deploy_key_here

# Your Convex deployment name (e.g. prod:your-project-name)
CONVEX_DEPLOYMENT=prod:your-deployment-name

# Your Convex backend URL
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud
